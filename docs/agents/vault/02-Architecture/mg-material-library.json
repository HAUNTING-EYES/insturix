{
  "_schema": {
    "purpose": "Signal-scored MATERIAL library for the MG spine (fonts + colour). Paint, not stencils: signals x brand select materials, engine generates. See MG-Material-Libraries.md.",
    "font": "family | category | roles[heading|body|mono|display] | signals{f=formality,e=energy,w=warmth 0-1} | personality | weights[] | pairsWith[ids] | constraints{minSizePx,headlineOnly,neverCaptions} | googleFont(loadable via @remotion/google-fonts)",
    "colourPalette": "FALLBACK-ONLY (brand supplies NO colour). Colour HUE = brand + meaning, NEVER mood/signal (see MG-Material-Libraries COLOUR CORRECTION). 'surface' assumes a dark canvas, but MG sits over FOOTAGE -> legibility is a MEASURED footage-aware floor, not vs surface. Fields: id|mood|signals|surface|neutral|primary|accent|harmony (HEX). See also semanticColours (fixed, meaning-driven) + harmonyRules (brand-hex -> fixed-hue ramp).",
    "selection": "Per VIDEO (= the register): score each material's signals vs the video's signal snapshot (utility-scorer), pick one heading+body PAIR + one palette, bounded by brand. Per moment only intensity varies. Coherence: max 2-3 families, contrast on ONE axis, persist per video.",
    "status": "Curated STARTER (~70 fonts, 16 palettes). Extensible to hundreds — same format. Refine tags against real video renders (Phase F)."
  },

