# Upstash QStash Configuration
UPSTASH_QSTASH_CURRENT_SIGNING_KEY=your_current_signing_key_here
UPSTASH_QSTASH_NEXT_SIGNING_KEY=your_next_signing_key_here
UPSTASH_QSTASH_TOKEN=your_qstash_token_here

# Upstash Redis Configuration
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token_here

# Job Configuration
CLICKATRON_JOB_TTL_SECONDS=21600
CLICKATRON_JOB_SSE_MAX_SECONDS=95

# Google Cloud Storage Configuration
GCS_BUCKET=clickatron-bucket
GCS_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000