# Next.js Environment Variables

# Authentication (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your-publishable-key
CLERK_SECRET_KEY=your-secret-key
CLERK_WEBHOOK_SIGNING_SECRET=your-webhook-signing-secret

# Alyzitron Service
ALYZITRON_BACKEND_URL=http://localhost:8000
ALYZITRON_GCS_BUCKET_NAME=your-alyzitron-bucket-name
GOOGLE_CLOUD_CREDENTIALS=your-base64-encoded-service-account-json

# Editron Service
EDITRON_GCS_BUCKET_NAME=your-editron-bucket-name

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=your-database-name  

# Service Limits
ALYZITRON_MAX_FILE_SIZE=500000000 # 500MB
ALYZITRON_MAX_CONCURRENT_ANALYSES=3
ALYZITRON_MAX_MONTHLY_ANALYSES=100

# Debug Configuration
ALYZITRON_DEBUG=false # Set to 'true' to enable debug logging for Alyzitron services

# Error Tracking (optional)
ERROR_TRACKING_DSN=your-error-tracking-dsn

# Razorpay Configuration
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_SECRET_KEY_ID=your-razorpay-secret-key
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Cron Job Security
CRON_SECRET=your-secure-cron-secret-key

# Note: In development, copy this file to .env.local
# For production, set these environment variables in your deployment platform

# Google Verification ID
GOOGLE_VERIFICATION_ID=your-google-verification-id
GOOGLE_ADSENSE=your-google-adsense-id