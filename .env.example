# .env.example
# Copy this file to .env and fill in real values.

### DEVELOPMENT

# Clerk Auth Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=REPLACE_WITH_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=REPLACE_WITH_CLERK_SECRET_KEY
CLERK_WEBHOOK_SECRET=REPLACE_WITH_CLERK_WEBHOOK_SECRET
NEXT_PUBLIC_APP_URL=https://localhost:3000

# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_DB_NAME=your_db_name

# Razorpay Configuration
RAZORPAY_KEY_ID=REPLACE_WITH_RAZORPAY_KEY_ID
NEXT_PUBLIC_RAZORPAY_KEY_ID=REPLACE_WITH_RAZORPAY_KEY_ID
RAZORPAY_SECRET_KEY_ID=REPLACE_WITH_RAZORPAY_SECRET_KEY
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_RAZORPAY_WEBHOOK_SECRET

# API Keys
YOUTUBE_API_KEY=REPLACE_WITH_YOUTUBE_API_KEY

# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Service Configuration
ALYZITRON_MONGO_COLLECTION=alyzitron_tasks
ALYZITRON_DEBUG=false
GOOGLE_CLOUD_PROJECT=your-gcp-project

# Base64 converted string of a JSON string.
GOOGLE_CLOUD_CREDENTIALS=BASE64_ENCODED_CREDENTIALS

CLICKATRON_MONGO_COLLECTION=clickatron_tasks

SERVICES_WEBHOOK_SECRET=REPLACE_WITH_SERVICES_WEBHOOK_SECRET
GCS_BUCKET_NAME=your-gcs-bucket

CRON_SECRET=REPLACE_WITH_CRON_SECRET
ADMIN_SECRET_KEY=REPLACE_WITH_ADMIN_SECRET_KEY
MONOLITHIC_BACKEND_URL=http://localhost:8000
MONOLITHIC_BACKEND_SECRET=REPLACE_WITH_MONOLITHIC_BACKEND_SECRET

APP_ENV=development